# 서버 포트
PORT=3000

# 도메인 (docker compose로 운영할 때 필수 — Caddy가 HTTPS 인증서를 자동 발급)
# DOMAIN=miart.example.com

# 운영 모드 (예시·짧은 관리자 비밀번호를 거부하고 보안 경고를 켬)
# NODE_ENV=production

# 데이터 저장 위치 (SQLite DB + 이미지). 기본값: ./data
# DATA_DIR=./data

# 최초 관리자 계정 (서버 시작 시 관리자가 없으면 자동 생성)
ADMIN_EMAIL=admin@miart.school
ADMIN_PASSWORD=change-me-please
# ↑ 운영 서버에서는 10자 이상, 예시가 아닌 비밀번호로 바꿔야 관리자 계정이 만들어집니다.

# HTTPS 뒤에서 운영할 때 true (쿠키 Secure 플래그)
COOKIE_SECURE=false

# 리버스 프록시 신뢰 범위 (기본 loopback). docker compose 구성은 자동으로 'loopback, uniquelocal'
# TRUST_PROXY=loopback

# AI 기능 (AI 주제 도안, 그림 마음 탐색 AI 요약). 없으면 AI 기능만 꺼지고 나머지는 모두 동작합니다.
# ANTHROPIC_API_KEY=sk-ant-...

# 학급당 하루 AI 호출 한도
AI_DAILY_LIMIT_PER_CLASS=60
